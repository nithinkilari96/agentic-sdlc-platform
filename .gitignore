# Secrets — never commit
.env
*.pem
*.key

# Build output
build/
out/
bin/
!gradle/wrapper/gradle-wrapper.jar

# Gradle
.gradle/

# IDE / local tooling
.idea/
*.iml
*.iws
.vscode/
.claude/settings.local.json

# OS
.DS_Store

# Agent runtime artifacts (generated workspaces, snapshots, logs)
workspaces/
workspaces-snapshots/
run-artifacts/
*.log

# Local H2 database. Runtime state, not source - and it embeds absolute
# workspace paths, so committing it leaks the developer's home directory.
data/
*.mv.db
*.trace.db

# Private working notes, never part of the submission
INTERVIEW-NOTES.md
